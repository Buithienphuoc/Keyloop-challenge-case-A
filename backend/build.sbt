// Unified Service Scheduler – backend API (Scala 3 + Play 3)
ThisBuild / scalaVersion := "3.3.6"
ThisBuild / organization := "com.example.scheduler"

val embeddedPgBinaries = "17.6.0"
val prometheus = "1.10.0"
val jackson = "2.19.1"
val otel = "1.55.0"

lazy val root = (project in file("."))
  .enablePlugins(PlayScala)
  .settings(
    name := "service-scheduler",
    version := "0.1.0",
    // Play already adds -deprecation, -unchecked and -feature. Generated route files are exempt from lint.
    scalacOptions ++= Seq("-Wunused:all", "-Werror", "-Wconf:src=.*routes.*:s", "-Wconf:src=src_managed/.*:s",
      // Scala 3.7+ asks for `using` when passing play-json's implicit Reads explicitly; play-json's API needs it.
      "-Wconf:msg=Implicit parameters should be provided with a `using` clause:s",
      // Scala 3.10 deprecates Predef.ArrowAssoc, which code generated by play-json's Json.writes macro still uses.
      "-Wconf:msg=ArrowAssoc.*deprecated:s"),
    PlayKeys.playDefaultPort := 8081,
    libraryDependencies ++= Seq(
      filters,
      "com.zaxxer"                % "HikariCP"                  % "6.3.0",
      "org.playframework.anorm"  %% "anorm"                     % "2.7.0",
      "org.postgresql"            % "postgresql"                % "42.7.7",
      "org.flywaydb"              % "flyway-core"               % "11.20.3",
      "org.flywaydb"              % "flyway-database-postgresql" % "11.20.3",
      // A real PostgreSQL started from Maven-packaged binaries, so `sbt run` needs no Docker.
      "io.zonky.test"             % "embedded-postgres"         % "2.1.0",
      "net.logstash.logback"      % "logstash-logback-encoder"  % "8.0",
      "io.prometheus"             % "prometheus-metrics-core"   % prometheus,
      "io.prometheus"             % "prometheus-metrics-exposition-formats" % prometheus,
      "io.prometheus"             % "prometheus-metrics-instrumentation-jvm" % prometheus,
      "org.webjars"               % "swagger-ui"                % "5.17.14",
      // Distributed tracing: spans for every request, booking attempt and SQL statement,
      // exported over OTLP when OTEL_EXPORTER_OTLP_ENDPOINT is set (e.g. to Jaeger).
      "io.opentelemetry"          % "opentelemetry-api"         % otel,
      "io.opentelemetry"          % "opentelemetry-sdk"         % otel,
      "io.opentelemetry"          % "opentelemetry-exporter-otlp" % otel,
      "io.opentelemetry"          % "opentelemetry-sdk-extension-autoconfigure" % otel,
      "org.scalatestplus.play"   %% "scalatestplus-play"        % "7.0.2"    % Test,
      "org.scalatestplus"        %% "scalacheck-1-18"           % "3.2.19.0" % Test,
      "org.scalacheck"           %% "scalacheck"                % "1.18.1"   % Test
    ),
    // Same PostgreSQL major version on every developer OS.
    libraryDependencies ++= Seq("darwin-amd64", "darwin-arm64v8", "linux-amd64", "linux-arm64v8", "windows-amd64").map { platform =>
      "io.zonky.test.postgres" % s"embedded-postgres-binaries-$platform" % embeddedPgBinaries % Runtime
    },
    // Flyway and logstash-logback-encoder bring a newer Jackson than Play/Pekko; align every
    // Jackson module on it, or jackson-module-scala refuses to start.
    dependencyOverrides ++= Seq(
      "com.fasterxml.jackson.core"       % "jackson-databind"               % jackson,
      "com.fasterxml.jackson.core"       % "jackson-core"                   % jackson,
      "com.fasterxml.jackson.core"       % "jackson-annotations"            % jackson,
      "com.fasterxml.jackson.dataformat" % "jackson-dataformat-cbor"        % jackson,
      "com.fasterxml.jackson.datatype"   % "jackson-datatype-jdk8"          % jackson,
      "com.fasterxml.jackson.datatype"   % "jackson-datatype-jsr310"        % jackson,
      "com.fasterxml.jackson.module"     % "jackson-module-parameter-names" % jackson,
      "com.fasterxml.jackson.module"    %% "jackson-module-scala"           % jackson
    ),
    excludeDependencies += "io.zonky.test.postgres" % "embedded-postgres-binaries-linux-amd64-alpine",
    // Integration tests share one embedded PostgreSQL; each suite gets its own database.
    Test / fork := true,
    Test / parallelExecution := false,
    Test / javaOptions ++= Seq("-Xmx2g", "-Duser.timezone=UTC", "-DLOG_LEVEL=ERROR"),
    Test / testOptions += Tests.Argument(TestFrameworks.ScalaTest, "-oD")
  )

// `sbt loadTest` fires 1000 simultaneous requests at a real HTTP server (skipped by `sbt test`).
addCommandAlias("loadTest", """set Test / javaOptions += "-Dscheduler.loadTest=true"; testOnly scheduler.load.*""")
