// Data flow diagram, level 0 (context). Render: dot -Tpng -Gdpi=150 dfd-context.dot -o dfd-context.png
digraph context {
  graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, nodesep=0.5, ranksep=1.6, pad=0.4,
         label="Data flow diagram, level 0 (context): Unified Service Scheduler\n\n"];
  node  [fontname="Helvetica", fontsize=13, color="#1F2A30", penwidth=1.4];
  edge  [fontname="Helvetica", fontsize=11, color="#56636B", fontcolor="#1F2A30", arrowsize=0.8];

  node [shape=box, style=filled, fillcolor="#F3F5F4", width=1.9, height=0.8];
  customer   [label="Customer"];
  advisor    [label="Service advisor", fillcolor="#EEF0F0", color="#A7B0B4", fontcolor="#7D878C"];
  technician [label="Technician"];
  admin      [label="Dealership admin", fillcolor="#EEF0F0", color="#A7B0B4", fontcolor="#7D878C"];
  sysmgr     [label="System manager"];
  controller [label="Workshop controller", fillcolor="#EEF0F0", color="#A7B0B4", fontcolor="#7D878C"];
  partsStaff [label="Parts staff", fillcolor="#EEF0F0", color="#A7B0B4", fontcolor="#7D878C"];
  monitor    [label="Monitoring platform\n(Prometheus, Jaeger, log store)"];

  system [shape=circle, style=filled, fillcolor="#1D4E89", fontcolor=white, fontsize=15, width=2.6, fixedsize=true,
          label="0\nUnified Service\nScheduler"];

  { rank=same; customer; sysmgr; }
  { rank=same; advisor; technician; admin; controller; partsStaff; monitor; }

  customer -> system [label="credentials, vehicle details,\nhold request (package, dealership, start,\nIdempotency-Key), hold confirmation,\nadvice request, cancellation"];
  system -> customer [label="session token, packages and checklists,\nfree slots, hold with expiry, confirmation\nor 3 alternatives,\nadvice decision, appointment status"];

  sysmgr -> system [label="new dealership (hours, zone, grid),\nfirst admin account, service packages"];
  system -> sysmgr [label="dealership list with capacity,\npackage catalogue, all data\n(appointments, bays, technicians,\nvehicles, people)"];

  system -> advisor [label="day board (bays x hours),\nadvice request queue", color="#B5BFBB", fontcolor="#7D878C"];
  advisor -> system [label="advice decision (duration, skill,\nbay type, estimate), start / done /\nno-show / cancel, parts order", color="#B5BFBB", fontcolor="#7D878C"];

  system -> technician [label="today's assigned jobs"];
  technician -> system [label="job started, finished,\nclosed once paid"];

  system -> controller [label="workload per bay and technician", color="#B5BFBB", fontcolor="#7D878C"];
  controller -> system [label="job moves (bay, technician, reason)", color="#B5BFBB", fontcolor="#7D878C"];

  system -> partsStaff [label="stock levels, parts orders", color="#B5BFBB", fontcolor="#7D878C"];
  partsStaff -> system [label="stock changes, order → receive → issue", color="#B5BFBB", fontcolor="#7D878C"];

  admin -> system [label="service bays, technicians\n(skills, shifts, days), staff accounts,\nopening hours and booking rules", color="#B5BFBB", fontcolor="#7D878C"];
  system -> admin [label="resource lists", color="#B5BFBB", fontcolor="#7D878C"];

  system -> monitor [label="JSON log lines (requestId, traceId),\n/metrics, /health, OTLP traces"];

  legend [shape=plaintext, style="", fixedsize=false, width=0, height=0, fontsize=11, fontcolor="#1F2A30", label=<<table border="1" cellborder="0" cellpadding="4" color="#B5BFBB">
    <tr><td bgcolor="#1D4E89" width="14">  </td><td align="left">In this version: customer, technician, system manager</td></tr>
    <tr><td bgcolor="#EEF0F0" border="1" width="14">  </td><td align="left"><font color="#7D878C">Grey: not in this version of the web app (the backend still has it)</font></td></tr>
  </table>>];
}
