@startuml use-case-customer
!include _style.iuml
title Use cases — customer
left to right direction

actor Customer

rectangle "Unified Service Scheduler" {
  usecase "UC01 Register an account" as UC01
  usecase "UC02 Sign in / sign out" as UC02
  usecase "UC03 Manage my vehicles" as UC03
  usecase "UC04 Book a maintenance package" as UC04
  usecase "UC05 Ask for an inspection\non request" as UC05 <<off>>
  usecase "UC06 Ask for a customisation" as UC06 <<off>>
  usecase "UC07 Book an approved request" as UC07 <<off>>
  usecase "UC08 View my appointments" as UC08
  usecase "UC09 Cancel an appointment" as UC09
  usecase "UC10 Withdraw a request" as UC10 <<off>>
  usecase "UC11 Add an appointment\nto my calendar" as UC11
  usecase "UC12 Hold a time for 10 minutes,\nthen confirm it" as UC12

  rectangle "Scheduling core" {
    usecase "UC20 Check real-time availability\n(bay of the right type AND\nqualified technician on shift)" as UC20
    usecase "UC21 Allocate bay and technician\n(best fit, never double-booked)" as UC21
    usecase "UC22 Offer the nearest\nfree alternatives" as UC22
  }

  usecase "Reschedule an appointment" as F02 #F6F7F7;line.dashed;line:6F7D84;text:6F7D84
  usecase "Receive reminders\n(SMS / Zalo / email)" as F03 #F6F7F7;line.dashed;line:6F7D84;text:6F7D84
}

Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC04
Customer -[#B5BFBB]- UC05
Customer -[#B5BFBB]- UC06
Customer -[#B5BFBB]- UC07
Customer -- UC08
Customer -- UC09
Customer -[#B5BFBB]- UC10
Customer -- UC11
Customer .. F02
Customer .. F03

Customer -- UC12

UC04 ..> UC12 : <<include>>
UC07 .[#B5BFBB].> UC12 : <<include>>
UC04 ..> UC20 : <<include>>
UC04 ..> UC21 : <<include>>
UC07 .[#B5BFBB].> UC20 : <<include>>
UC07 .[#B5BFBB].> UC21 : <<include>>
UC22 ..> UC04 : <<extend>>\nslot taken meanwhile
UC22 .[#B5BFBB].> UC07 : <<extend>>
UC05 .[#B5BFBB].> UC07 : <<precedes>>\nafter advisor approval
UC06 .[#B5BFBB].> UC07 : <<precedes>>

legend bottom right
  Blue: in this version    Solid grey: not in this version (needs a service advisor)
  Dashed grey: future work, not built
endlegend
@enduml
