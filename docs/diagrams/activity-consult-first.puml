@startuml activity-consult-first
!include _style.iuml
skinparam ActivityDiamondBackgroundColor #F4F5F5
skinparam ActivityDiamondFontColor #7D878C
title Activity — inspection on request / customisation (UC05, UC06, UC31, UC07)\n<color:#7D878C>Not in this version: it needs a service advisor</color>

|#EEF0F0|Customer|
|#EEF0F0|Service advisor|
|#EEF0F0|System|
|#EEF0F0|Customer|
start
#EEF0F0:Choose "Check something specific"
or "Customise my vehicle"; <<off>>
#EEF0F0:Pick the vehicle and the areas,
describe it in own words, pick a dealership; <<off>>
#EEF0F0:Send to an advisor; <<off>>
|#EEF0F0|System|
#EEF0F0:Store the request: **SUBMITTED**,
log consultation.submitted; <<off>>
|#EEF0F0|Service advisor|
#EEF0F0:Open the "Waiting for advice" queue; <<off>>
#EEF0F0:Read the areas and the description; <<off>>
if (Can the workshop do it?) then (no)
  #EEF0F0:Decline with a message to the customer; <<off>>
  |System|
  #EEF0F0:**REJECTED**; <<off>>
  |Customer|
  #EEF0F0:Read the advisor's reason; <<off>>
  stop
else (yes)
  |Service advisor|
  #EEF0F0:Set time needed, skill, bay type,
  estimate and a message, then approve; <<off>>
  note right
    The server checks the bay type fits the vehicle
    and the skill exists; if not → 422 and the
    advisor corrects it.
  end note
  |System|
  #EEF0F0:**APPROVED**, log consultation.reviewed; <<off>>
endif
|#EEF0F0|Customer|
#EEF0F0:See the reply on Home and on Requests
(duration, estimate, advisor's note); <<off>>
if (Book it?) then (withdraw)
  |System|
  #EEF0F0:**CANCELLED**; <<off>>
  stop
else (pick a time)
  repeat
    |Customer|
    #EEF0F0:Pick a start time — only times with a bay of the
    approved type and a technician with the approved skill; <<off>>
    |System|
  repeat while (Still APPROVED and the slot still free?) is (slot taken: offer alternatives)
  -> yes;
  note right
    Already booked by another tab or device
    → 409 CONSULTATION_NOT_BOOKABLE
  end note
  #EEF0F0:In one transaction: appointment **HELD** for 10 minutes,
  request **BOOKED**; <<off>>
  |Customer|
  #EEF0F0:Review and press **Confirm booking**; <<off>>
  |System|
  if (Confirmed before the hold ran out?) then (yes)
    #EEF0F0:HELD → **CONFIRMED**; <<off>>
  else (no)
    #EEF0F0:HELD → **EXPIRED**,
    request back to **APPROVED**
    so another time can be picked; <<off>>
    stop
  endif
endif
|#EEF0F0|Customer|
if (Cancels before the start?) then (yes)
  |System|
  #EEF0F0:Appointment CANCELLED,
  request back to **APPROVED**
  so another time can be picked; <<off>>
else (no)
endif
stop
legend bottom right
  Solid grey: not in this version of the web app (the backend still has it).
  The customer books a maintenance package instead (activity-book-package).
endlegend
@enduml
